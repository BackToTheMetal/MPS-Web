load("@j2cl//build_defs:rules.bzl", "j2cl_library")

package(
    default_visibility = ["//visibility:public"],
)

j2cl_library(
    name = "logging-j2cl",
    srcs = glob(
        ["source/**/*.java"],
        exclude = [
             "source/jetbrains/mps/logging/JULogger.java",
         ],
     ) + glob([
         "j2cl_src/**/*.java",
     ]),
    deps = [
        "//core/mps-annotations:mps-annotations-j2cl",
        "@org_jetbrains_annotations-j2cl",
    ],
)